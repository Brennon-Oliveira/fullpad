{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fullpad",
  "version": "0.1.0",
  "identifier": "dev.brennon.fullpad",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fullpad",
        "width": 960,
        "height": 640,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Editor de notas e markdown rápido",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Texto",
        "description": "Documento de texto",
        "mimeType": "text/plain",
        "role": "Editor"
      },
      {
        "ext": [
          "dbml",
          "dbmlx"
        ],
        "name": "DBML",
        "description": "Diagrama DBML",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
