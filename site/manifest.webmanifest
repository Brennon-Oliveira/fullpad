{
  "name": "Fullpad",
  "short_name": "Fullpad",
  "description": "Editor de texto grátis e de código aberto para Windows e Linux. Markdown renderizado, CSV em tabela, JSON em árvore, Mermaid, DBML, PDF e arquivos de GBs, sem perder nada ao fechar.",
  "lang": "pt-BR",
  "start_url": "./",
  "display": "browser",
  "background_color": "#0e0f14",
  "theme_color": "#0e0f14",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
